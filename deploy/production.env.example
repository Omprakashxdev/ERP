# Production deployment configuration — copy to deploy/production.env and
# fill in values verified ON the live server. This file is gitignored; never
# commit real hostnames, paths or credentials.
#
# Every value below is REQUIRED. The deploy script refuses to run with any
# placeholder left in place. Do NOT guess — verify each on the server first.

# SSH target for the LIVE server. The known demo/old host 156.67.105.64 is
# hard-rejected regardless of what is set here.
#   Find it: dig +short erp.adelphostech.com
DEPLOY_HOST=""

# SSH username that owns the app directory (do NOT assume root works).
DEPLOY_USER=""

# Absolute application directory on the server (git checkout root).
#   Find it: pm2 describe <app> | grep -i "exec cwd"  (or pm2_cwd in pm2 info)
DEPLOY_DIR=""

# PM2 process name exactly as listed by `pm2 list`.
PM2_APP=""

# Live PostgreSQL database name and the role that owns the schema.
#   Find it: \l in psql, or DATABASE_URL in the app .env
DB_NAME=""
DB_USER=""

# Public site URL used for post-deploy smoke checks.
SITE_URL=""

# Optional but recommended: expected remote `hostname` output. When set, the
# script aborts if the SSH probe reports anything else — a last line of
# defense against targeting the wrong machine.
EXPECTED_HOSTNAME=""

# Expected remote git SHA at DEPLOY_DIR before the release (the commit the
# server is currently running). Deploy aborts on mismatch.
#   Find it: ssh <server> git -C <DEPLOY_DIR> rev-parse HEAD
EXPECTED_CURRENT_SHA=""

# Set to "yes" ONLY after the backup produced by this deploy has been
# restored into a disposable database and record counts verified. Without
# this attestation --execute refuses to proceed.
RESTORE_REHEARSAL_DONE=""
